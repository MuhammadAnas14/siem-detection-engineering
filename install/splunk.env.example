# ---------------------------------------------------------------------------
# Deployment environment. Copy to splunk.env and adjust; every install script
# sources it.
#   cp splunk.env.example splunk.env && chmod 600 splunk.env
#
# splunk.env is gitignored. Nothing tracked in this repo contains a working
# credential.
# ---------------------------------------------------------------------------

# --- Splunk Enterprise (indexer + search head, standalone) ------------------
SPLUNK_VERSION="9.4.3"
SPLUNK_BUILD="b5e4f9b5b2a2"              # build hash from the download page
SPLUNK_HOME="/opt/splunk"
SPLUNK_USER="splunk"
SPLUNK_GROUP="splunk"

# The indexer's address as the forwarders see it.
INDEXER_HOST="10.20.30.10"
INDEXER_S2S_PORT="9997"                  # forwarder-to-indexer (S2S)
SPLUNK_WEB_PORT="8000"
SPLUNK_MGMT_PORT="8089"
HEC_PORT="8088"

# First-run admin credentials (user-seed.conf). Change before use.
SPLUNK_ADMIN_USER="admin"
SPLUNK_ADMIN_PASSWORD="ChangeMe_Now!"

# Optional: path to a licence file applied during install.
# Leave empty to stay on the 60-day Enterprise Trial.
SPLUNK_LICENSE_FILE=""

# Daily indexing quota in GB, used by the licence-pressure alert.
LICENSE_QUOTA_GB="5"

# --- Universal Forwarders ---------------------------------------------------
UF_VERSION="9.4.3"
UF_HOME="/opt/splunkforwarder"
UF_HOME_WIN="C:\\Program Files\\SplunkUniversalForwarder"

# --- Retention --------------------------------------------------------------
RETENTION_SECS="15552000"                # 180 days

# --- Alert routing ----------------------------------------------------------
SOC_ALERT_EMAIL="soc@example.com"
SOC_WEBHOOK_URL="https://soc-portal.example.com/api/v1/alerts"
SMTP_SERVER="smtp.example.com:25"
SMTP_FROM="splunk-siem@example.com"

# --- Database inputs (DB Connect) -------------------------------------------
MYSQL_HOST="10.20.30.40"
MYSQL_PORT="3306"
MYSQL_DB="appdb"
MYSQL_USER="splunk_ro"
MYSQL_PASSWORD="ChangeMe_Db!"
MSSQL_HOST="10.20.30.41"
MSSQL_PORT="1433"
MSSQL_DB="secdb"
